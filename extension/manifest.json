{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Save to Gallery",
  "description": "Save web captures or drop local files and folders into your laniameda collections",
  "version": "0.10.4",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "contextMenus", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["image-convert.js", "image-qualification.js", "midjourney-adapter.js", "krea-adapter.js", "higgsfield-adapter.js", "pinterest-adapter.js", "shotdeck-adapter.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open laniameda upload desk",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "add-selected-asset": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Add the selected Midjourney image to the gallery"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
